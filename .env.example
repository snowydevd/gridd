# Los genera `bun run convex` (convex dev) la primera vez.
CONVEX_DEPLOYMENT=dev:<deployment>
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Maps SDK for Android (Google Cloud). Sólo hace falta para development/production builds;
# Expo Go trae su propia key. En EAS cargala con `bunx eas-cli env:create`.
GOOGLE_MAPS_ANDROID_API_KEY=
